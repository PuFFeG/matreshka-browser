diff --git a/security/manager/ssl/MatreshkaTrust.cpp b/security/manager/ssl/MatreshkaTrust.cpp
new file mode 100644
--- /dev/null
+++ b/security/manager/ssl/MatreshkaTrust.cpp
@@ -0,0 +1,272 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* vim: set ts=8 sts=2 et sw=2 tw=80: */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "MatreshkaTrust.h"
+
+#include <stdint.h>
+#include <utility>
+
+#include "mozilla/Base64.h"
+#include "mozilla/RefPtr.h"
+#include "mozilla/StaticMutex.h"
+#include "mozilla/StaticPrefs_matreshka.h"
+#include "mozpkix/pkixutil.h"
+#include "nsError.h"
+#include "nsISupportsImpl.h"
+#include "nsReadableUtils.h"
+
+namespace mozilla {
+namespace psm {
+
+using mozilla::pkix::BackCert;
+using mozilla::pkix::EndEntityOrCA;
+using mozilla::pkix::Input;
+using mozilla::pkix::InputsAreEqual;
+using mozilla::pkix::Result;
+using mozilla::pkix::Success;
+
+namespace {
+
+class MatreshkaTrustData final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(MatreshkaTrustData)
+
+  nsTArray<nsCString> mHosts;
+  nsTArray<nsTArray<uint8_t>> mCerts;
+
+ private:
+  ~MatreshkaTrustData() = default;
+};
+
+StaticMutex sMatreshkaTrustMutex;
+nsCString sMatreshkaTrustCachedPref;
+RefPtr<MatreshkaTrustData> sMatreshkaTrustCachedData;
+
+void TrimASCII(nsACString& aString) {
+  static constexpr const char kWhitespace[] = " \t\r\n";
+  aString.Trim(kWhitespace);
+}
+
+void ParseHostLine(const nsACString& aLine, MatreshkaTrustData& aData) {
+  uint32_t start = 0;
+  while (start <= aLine.Length()) {
+    int32_t comma = aLine.FindChar(',', start);
+    uint32_t end = comma == kNotFound ? aLine.Length() : comma;
+    nsCString host(Substring(aLine, start, end - start));
+    TrimASCII(host);
+    if (!host.IsEmpty()) {
+      ToLowerCase(host);
+      if (host.Length() > 1 && host.Last() == '.') {
+        host.Truncate(host.Length() - 1);
+      }
+      aData.mHosts.AppendElement(std::move(host));
+    }
+    if (comma == kNotFound) {
+      break;
+    }
+    start = comma + 1;
+  }
+}
+
+void ParseCertificateLine(const nsACString& aLine, MatreshkaTrustData& aData) {
+  nsCString decoded;
+  if (NS_FAILED(Base64Decode(aLine, decoded)) || decoded.IsEmpty()) {
+    return;
+  }
+
+  nsTArray<uint8_t> der;
+  der.AppendElements(reinterpret_cast<const uint8_t*>(decoded.BeginReading()),
+                     decoded.Length());
+
+  Input certInput;
+  if (certInput.Init(der.Elements(), der.Length()) != Success) {
+    return;
+  }
+  BackCert cert(certInput, EndEntityOrCA::MustBeCA, nullptr);
+  if (cert.Init() != Success) {
+    return;
+  }
+
+  aData.mCerts.AppendElement(std::move(der));
+}
+
+already_AddRefed<MatreshkaTrustData> ParseTrustData(
+    const nsACString& aPrefValue) {
+  RefPtr<MatreshkaTrustData> data = new MatreshkaTrustData();
+
+  bool sawHostLine = false;
+  uint32_t start = 0;
+  while (start <= aPrefValue.Length()) {
+    int32_t newline = aPrefValue.FindChar('\n', start);
+    uint32_t end = newline == kNotFound ? aPrefValue.Length()
+                                        : static_cast<uint32_t>(newline);
+
+    nsCString line(Substring(aPrefValue, start, end - start));
+    TrimASCII(line);
+    if (!line.IsEmpty() && line.CharAt(0) != '#') {
+      if (!sawHostLine) {
+        ParseHostLine(line, *data);
+        sawHostLine = true;
+      } else {
+        ParseCertificateLine(line, *data);
+      }
+    }
+
+    if (newline == kNotFound) {
+      break;
+    }
+    start = end + 1;
+  }
+
+  return data.forget();
+}
+
+already_AddRefed<MatreshkaTrustData> GetTrustData() {
+  nsCString prefValue;
+  {
+    // matreshka.trust.json is a DataMutexString. Its getter returns a locked
+    // handle, which makes this read safe on the certificate verification
+    // thread. Copy the value while holding the lock and parse outside it.
+    auto prefLock = StaticPrefs::matreshka_trust_json();
+    prefValue = *prefLock;
+  }
+
+  StaticMutexAutoLock lock(sMatreshkaTrustMutex);
+  if (sMatreshkaTrustCachedData &&
+      sMatreshkaTrustCachedPref.Equals(prefValue)) {
+    return do_AddRef(sMatreshkaTrustCachedData.get());
+  }
+
+  RefPtr<MatreshkaTrustData> data = ParseTrustData(prefValue);
+  sMatreshkaTrustCachedPref = prefValue;
+  sMatreshkaTrustCachedData = data;
+  return data.forget();
+}
+
+bool HostMatches(const nsCString& aEntry, const nsCString& aHost) {
+  if (aEntry.IsEmpty()) {
+    return false;
+  }
+  if (aEntry.CharAt(0) == '.') {
+    return aHost.Length() > aEntry.Length() && StringEndsWith(aHost, aEntry);
+  }
+  return aHost.Equals(aEntry);
+}
+
+void NormalizeHost(const nsACString& aHost, nsCString& aHostOut) {
+  aHostOut.Assign(aHost);
+  TrimASCII(aHostOut);
+  ToLowerCase(aHostOut);
+  if (aHostOut.Length() > 1 && aHostOut.Last() == '.') {
+    aHostOut.Truncate(aHostOut.Length() - 1);
+  }
+}
+
+bool IsHostListed(const MatreshkaTrustData* aData, const nsACString& aHost) {
+  if (!aData || aData->mHosts.IsEmpty()) {
+    return false;
+  }
+
+  nsCString host;
+  NormalizeHost(aHost, host);
+
+  for (const auto& entry : aData->mHosts) {
+    if (HostMatches(entry, host)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The .ru TLD and the punycode form of .рф.
+bool IsRussianTldHost(const nsACString& aHost) {
+  nsCString host;
+  NormalizeHost(aHost, host);
+  return StringEndsWith(host, ".ru"_ns) ||
+         StringEndsWith(host, ".xn--p1ai"_ns);
+}
+
+// Returns true when a host may use the bundled Russian Trusted CA
+// certificates: either it is explicitly allowlisted, or the .ru/.рф fallback
+// is enabled and the host is in one of those TLDs. The latter still requires
+// the presented chain to validate to one of the bundled roots; this function
+// never trusts arbitrary certificates.
+bool IsEligibleHost(const MatreshkaTrustData* aData, const nsACString& aHost) {
+  if (IsHostListed(aData, aHost)) {
+    return true;
+  }
+  return StaticPrefs::matreshka_trust_ru_fallback() && IsRussianTldHost(aHost);
+}
+
+}  // namespace
+
+bool IsMatreshkaListedHost(const nsACString& aHost) {
+  if (!StaticPrefs::matreshka_trust_enabled()) {
+    return false;
+  }
+  RefPtr<MatreshkaTrustData> data = GetTrustData();
+  return IsHostListed(data, aHost);
+}
+
+bool GetMatreshkaIssuerCandidates(
+    const nsACString& aHost, const mozilla::pkix::Input& aEncodedIssuerName,
+    nsTArray<nsTArray<uint8_t>>& aCandidateDERs) {
+  if (!StaticPrefs::matreshka_trust_enabled()) {
+    return false;
+  }
+
+  RefPtr<MatreshkaTrustData> data = GetTrustData();
+  if (!IsEligibleHost(data, aHost)) {
+    return false;
+  }
+
+  bool appended = false;
+  for (const auto& der : data->mCerts) {
+    Input certInput;
+    Result rv = certInput.Init(der.Elements(), der.Length());
+    if (rv != Success) {
+      continue;
+    }
+    BackCert cert(certInput, EndEntityOrCA::MustBeCA, nullptr);
+    if (cert.Init() != Success) {
+      continue;
+    }
+    if (!InputsAreEqual(aEncodedIssuerName, cert.GetSubject())) {
+      continue;
+    }
+    nsTArray<uint8_t> copy;
+    copy.AppendElements(der);
+    aCandidateDERs.AppendElement(std::move(copy));
+    appended = true;
+  }
+  return appended;
+}
+
+bool IsMatreshkaBundledTrustAnchor(
+    const nsACString& aHost, const mozilla::pkix::Input& aCandidateCertDER) {
+  if (!StaticPrefs::matreshka_trust_enabled()) {
+    return false;
+  }
+
+  RefPtr<MatreshkaTrustData> data = GetTrustData();
+  if (!IsEligibleHost(data, aHost)) {
+    return false;
+  }
+
+  for (const auto& der : data->mCerts) {
+    Input bundledInput;
+    if (bundledInput.Init(der.Elements(), der.Length()) != Success) {
+      continue;
+    }
+    if (InputsAreEqual(aCandidateCertDER, bundledInput)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace psm
+}  // namespace mozilla
diff --git a/security/manager/ssl/MatreshkaTrust.h b/security/manager/ssl/MatreshkaTrust.h
new file mode 100644
index 0000000..75a9374
--- /dev/null
+++ b/security/manager/ssl/MatreshkaTrust.h
@@ -0,0 +1,44 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* vim: set ts=8 sts=2 et sw=2 tw=80: */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_psm_MatreshkaTrust_h
+#define mozilla_psm_MatreshkaTrust_h
+
+#include <stdint.h>
+
+#include "mozpkix/pkixtypes.h"
+#include "nsString.h"
+#include "nsTArray.h"
+
+namespace mozilla {
+namespace psm {
+
+// Returns true when matreshka.trust.enabled is true and aHost is either an
+// exact entry in the bundle's host list or matches a ".suffix" entry. The
+// check is case-insensitive and a single trailing dot on aHost is ignored.
+bool IsMatreshkaListedHost(const nsACString& aHost);
+
+// For an allowlisted host, appends a copy of the DER bytes of every bundled
+// certificate whose subject matches aEncodedIssuerName. Returns true if at
+// least one candidate was appended.
+//
+// The certificate bytes are copied into aCandidateDERs so that callers can
+// create mozilla::pkix::Input objects that stay valid for the duration of
+// path building.
+bool GetMatreshkaIssuerCandidates(
+    const nsACString& aHost, const mozilla::pkix::Input& aEncodedIssuerName,
+    nsTArray<nsTArray<uint8_t>>& aCandidateDERs);
+
+// For an allowlisted host, returns true if aCandidateCertDER is byte-for-byte
+// identical to one of the certificates bundled in the trust data. Only these
+// exact certificates are promoted to trust anchors; nothing else is affected.
+bool IsMatreshkaBundledTrustAnchor(
+    const nsACString& aHost, const mozilla::pkix::Input& aCandidateCertDER);
+
+}  // namespace psm
+}  // namespace mozilla
+
+#endif  // mozilla_psm_MatreshkaTrust_h
